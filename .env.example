# Optional: Hugging Face token for Inference API (preferred when set)
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional override (default: black-forest-labs/FLUX.1-schnell)
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# If HF_TOKEN is empty, the script uses free Pollinations.ai automatically.

# Shopify Storefront API (public token is safe for the browser)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Optional: NEXT_PUBLIC_SHOPIFY_API_VERSION=2026-07
